    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/react-table": "^9.2.6",
    "better-sqlite3": "^13.0.3",
    "d3-scale": "^4.0.2",
    "effect": "^4.0.2",
    "hono": "^4.13.13",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
